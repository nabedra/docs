{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Nabedra",
  "description": "Documentation for Nabedra Database, the Python and TypeScript ORMs, Nabedra Cache, and Nabedra Events.",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#FAFAFA",
    "dark": "#0A0A0A"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Geologica"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "github-dark-default"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "guides/quickstart",
              "guides/installation",
              "guides/task-tracker"
            ]
          },
          {
            "group": "Database engines",
            "pages": [
              "server/olap",
              "server/oltp",
              "architecture/database",
              "architecture/oltp-transactions"
            ]
          },
          {
            "group": "Operate Nabedra",
            "pages": [
              "server/configuration",
              "server/worker-runtime",
              "server/clusters",
              "server/gateway",
              "server/providers",
              "operations/oltp-deployment",
              "operations/backup-and-migration",
              "operations/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Python ORM",
        "groups": [
          {
            "group": "Use the ORM",
            "pages": [
              "python/connect",
              "python/tables",
              "python/queries",
              "python/streaming"
            ]
          },
          {
            "group": "Request lifecycle",
            "pages": [
              "python/receipts",
              "python/errors"
            ]
          }
        ]
      },
      {
        "tab": "TypeScript ORM",
        "groups": [
          {
            "group": "Use the ORM",
            "pages": [
              "typescript/quickstart"
            ],
            "tag": "Preview"
          }
        ]
      },
      {
        "tab": "Cache",
        "groups": [
          {
            "group": "Nabedra Cache",
            "pages": [
              "server/cache",
              "cache/clients"
            ],
            "tag": "Preview"
          }
        ]
      },
      {
        "tab": "Events",
        "groups": [
          {
            "group": "Nabedra Events",
            "pages": [
              "events/broker",
              "events/python-client",
              "events/olap-sink",
              "events/aws"
            ],
            "tag": "Preview"
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "HTTP and command line",
            "pages": [
              "reference/database-http",
              "reference/streaming-http",
              "reference/events-http",
              "reference/cli",
              "reference/limits"
            ]
          },
          {
            "group": "Contribute",
            "pages": [
              "contributing/development",
              "contributing/verification",
              "contributing/scheduler-contract",
              "contributing/oltp-contract",
              "contributing/oltp-acceptance",
              "contributing/benchmarks"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/zPy52/nabedra-database"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/zPy52/nabedra-database"
    }
  }
}
